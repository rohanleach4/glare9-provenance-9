PROVENANCE_HOST=127.0.0.1
PROVENANCE_PORT=8787
PROVENANCE_API_TOKEN=replace-with-a-long-random-secret
# During rotation, configure new first and retained old second; remove old after clients move.
# PROVENANCE_API_TOKENS=replace-with-new-long-random-secret,replace-with-old-long-random-secret
# PROVENANCE_ADMIN_TOKEN=replace-with-a-separate-long-random-secret
# PROVENANCE_ADMIN_TOKENS=replace-with-new-admin-secret,replace-with-old-admin-secret
# PROVENANCE_TLS_CERT_PATH=/absolute/path/to/server-certificate.pem
# PROVENANCE_TLS_KEY_PATH=/absolute/path/to/server-private-key.pem
# PROVENANCE_TLS_CLIENT_CA_PATH=/absolute/path/to/client-ca.pem
# PROVENANCE_TLS_REQUIRE_CLIENT_CERTIFICATE=true
PROVENANCE_DATA_DIR=../../runtime/ledger-service
# PROVENANCE_SEGMENT_SIGNING_KEY_PATH=/absolute/path/to/customer-controlled-ed25519.pk8
# PROVENANCE_SEGMENT_TRUST_BUNDLE_PATH=/absolute/path/to/approved-segment-trust-bundle.json
PROVENANCE_SHARD_COUNT=1
PROVENANCE_ADOPT_LEGACY_ROUTING_HISTORY=false
PROVENANCE_MAX_BATCH_EVENTS=500
PROVENANCE_MAX_REQUEST_BYTES=8388608
PROVENANCE_BLOCK_MAX_BYTES=1048576
PROVENANCE_BLOCK_MAX_RECORDS=1000
PROVENANCE_SEGMENT_MAX_BYTES=33554432
PROVENANCE_SEGMENT_MAX_RECORDS=10000
PROVENANCE_SEGMENT_MAX_AGE_MS=30000
PROVENANCE_MAX_ACCEPTED_EVENTS=100000
PROVENANCE_MAX_ACCEPTED_BYTES=1073741824
PROVENANCE_MAX_ACTIVE_BLOCK_BYTES=16777216
