# MySQL connection. TLS is required by default; set disabled only for local development.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=glare9_provenance_connector
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=application_database
MYSQL_OUTBOX_TABLE=provenance_outbox
MYSQL_SSL_MODE=required
MYSQL_SSL_REJECT_UNAUTHORIZED=true
# MYSQL_SSL_CA may contain a PEM certificate chain.

# Provenance ledger service
PROVENANCE_URL=http://127.0.0.1:8787
PROVENANCE_API_TOKEN=replace-with-the-ledger-service-token

# Connector worker
CONNECTOR_ID=mysql-connector-1
CONNECTOR_BATCH_SIZE=100
CONNECTOR_POLL_INTERVAL_MS=1000
CONNECTOR_LEASE_SECONDS=30
CONNECTOR_MAX_ATTEMPTS=20
CONNECTOR_RETRY_BASE_MS=1000
CONNECTOR_RETRY_MAX_MS=60000
CONNECTOR_HEALTH_HOST=127.0.0.1
CONNECTOR_HEALTH_PORT=8790
